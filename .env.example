# Bootstrap credentials for the settings datastore only. Every other secret
# (Mongo, Security_16, SnowDB "pg" creds, AWS profiles, Requests API key,
# etc.) is stored in the `settings` Postgres table instead of this file and
# is configured/edited from the app's Settings page after first boot — not
# here. Run scripts/generate-settings-db-secret.sh to populate
# SETTINGS_DB_PASSWORD.
SETTINGS_DB_USER=settings
SETTINGS_DB_PASSWORD=changeme
SETTINGS_DB_NAME=settings
SETTINGS_DB_HOST=settings-db
SETTINGS_DB_PORT=5432

# Shared passphrase required to call GET /api/settings/export. This gates the
# one endpoint that returns real (unmasked) secret values, so treat it like
# any other production credential — share it out-of-band with engineers who
# need to export settings, don't commit a real value here.
SETTINGS_EXPORT_SECRET=changeme
